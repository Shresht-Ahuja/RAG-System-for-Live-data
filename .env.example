# Existing LLM configuration
API_KEY=your_groq_api_key

# Web application security. Generate TOKEN_ENCRYPTION_KEY with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_BASE_URL=http://localhost:8000
APP_ENV=development
SESSION_SECRET=replace_with_a_long_random_value
TOKEN_ENCRYPTION_KEY=replace_with_a_fernet_key
DATABASE_PATH=data/live_data_agent.db

# OAuth app credentials — registered once by the product owner, never by users.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Default: read:user public_repo. Do not set repo for a read-only product;
# use a GitHub App with read-only permissions for private repositories.
GITHUB_OAUTH_SCOPE=read:user public_repo
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# Optional local-only CLI / Obsidian configuration
GITHUB_TOKEN=
NOTION_TOKEN=
OBSIDIAN_VAULT_PATH=
