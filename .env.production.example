# Copy values to your deployment platform's secret manager. Never commit .env.
APP_BASE_URL=https://your-domain.example
APP_ENV=production
ALLOWED_HOSTS=your-domain.example
SESSION_SECRET=replace_with_a_long_random_value
TOKEN_ENCRYPTION_KEY=replace_with_a_fernet_key
DATABASE_PATH=data/live_data_agent.db

API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_SCOPE=read:user user:email
# Optional server-side read-only token used only to improve guest access to
# public repositories. Guest requests are still blocked from private repos.
GITHUB_PUBLIC_TOKEN=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
